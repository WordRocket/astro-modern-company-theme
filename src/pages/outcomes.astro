---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Outcomes" description="Proven results and case studies showing improved health outcomes and cost savings">
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-gradient-to-br from-primary-50 via-white to-accent-50 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(0,0,0,0.15) 1px, transparent 0); background-size: 30px 30px;"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center animate-on-scroll">
        <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-primary-100 to-accent-100 rounded-full text-sm font-semibold text-primary-700 mb-6">
          <span class="w-2 h-2 bg-accent-500 rounded-full mr-2 animate-pulse"></span>
          Evidence-Based Results
        </div>
        
        <h1 class="text-5xl md:text-6xl font-bold text-secondary-900 mb-6">
          Proven <span class="bg-gradient-to-r from-primary-600 to-accent-500 bg-clip-text text-transparent">Outcomes</span>
        </h1>
        
        <p class="text-xl text-secondary-600 leading-relaxed max-w-3xl mx-auto">
          Real results from healthcare organizations using our platform to improve member engagement, health outcomes, and reduce costs.
        </p>
      </div>
    </div>
  </section>

  <!-- Key Metrics Overview -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center animate-on-scroll">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
          <div class="text-4xl font-bold text-primary-600 mb-2">91%</div>
          <div class="text-secondary-600">Daily Engagement Rate</div>
        </div>
        
        <div class="text-center animate-on-scroll" style="animation-delay: 0.1s;">
          <div class="w-20 h-20 bg-gradient-to-br from-accent-500 to-accent-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="text-4xl font-bold text-accent-600 mb-2">16%</div>
          <div class="text-secondary-600">Medication Adherence Improvement</div>
        </div>
        
        <div class="text-center animate-on-scroll" style="animation-delay: 0.2s;">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-600 to-accent-500 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </div>
          <div class="text-4xl font-bold text-primary-600 mb-2">51%</div>
          <div class="text-secondary-600">Reduction in Admissions</div>
        </div>
        
        <div class="text-center animate-on-scroll" style="animation-delay: 0.3s;">
          <div class="w-20 h-20 bg-gradient-to-br from-accent-600 to-primary-500 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
          </div>
          <div class="text-4xl font-bold text-accent-600 mb-2">$15M+</div>
          <div class="text-secondary-600">Rewards Distributed</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  <section class="py-20 bg-gradient-to-br from-secondary-50 to-primary-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-6">
          Case Studies
        </h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          Real-world examples of how our platform transforms healthcare outcomes
        </p>
      </div>
      
      <div class="space-y-16">
        <!-- Case Study 1 -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden hover-lift animate-on-scroll">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="p-8 lg:p-12">
              <div class="inline-flex items-center px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
                Medicare Advantage Plan
              </div>
              <h3 class="text-3xl font-bold text-secondary-900 mb-4">
                Desert Oasis Healthcare
              </h3>
              <p class="text-lg text-secondary-600 mb-6 leading-relaxed">
                Achieved remarkable improvements in medication adherence and member engagement among hard-to-reach diabetic patients.
              </p>
              
              <div class="grid grid-cols-2 gap-6 mb-6">
                <div>
                  <div class="text-3xl font-bold text-primary-600 mb-1">92%</div>
                  <div class="text-sm text-secondary-600">Medication Adherence</div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-accent-600 mb-1">4.5★</div>
                  <div class="text-sm text-secondary-600">Star Rating Improvement</div>
                </div>
              </div>
              
              <blockquote class="text-secondary-700 italic border-l-4 border-primary-500 pl-4">
                "We securely sent our database of hard-to-reach patients with all their relevant conditions, and the platform did all the heavy lifting, including patient outreach and activation."
              </blockquote>
              <cite class="text-sm text-secondary-500 mt-2 block">- Dr. Brian Hodgkins, Executive VP of Clinical Operations</cite>
            </div>
            <div class="relative">
              <img src="https://images.pexels.com/photos/4386467/pexels-photo-4386467.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Healthcare provider consultation" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
            </div>
          </div>
        </div>

        <!-- Case Study 2 -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden hover-lift animate-on-scroll">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="relative lg:order-1">
              <img src="https://images.pexels.com/photos/3184360/pexels-photo-3184360.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Healthcare team meeting" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
            </div>
            <div class="p-8 lg:p-12 lg:order-2">
              <div class="inline-flex items-center px-3 py-1 bg-accent-100 text-accent-700 rounded-full text-sm font-semibold mb-4">
                Health Plan
              </div>
              <h3 class="text-3xl font-bold text-secondary-900 mb-4">
                Priority Health
              </h3>
              <p class="text-lg text-secondary-600 mb-6 leading-relaxed">
                Significant cost savings and improved health outcomes through enhanced member engagement and care plan adherence.
              </p>
              
              <div class="grid grid-cols-2 gap-6 mb-6">
                <div>
                  <div class="text-3xl font-bold text-accent-600 mb-1">$2.3M</div>
                  <div class="text-sm text-secondary-600">Cost Savings</div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-primary-600 mb-1">45%</div>
                  <div class="text-sm text-secondary-600">Reduced ED Visits</div>
                </div>
              </div>
              
              <blockquote class="text-secondary-700 italic border-l-4 border-accent-500 pl-4">
                "After starting our members on this platform, we've seen significant decreases in utilization and improved outcomes. The program more than paid for itself."
              </blockquote>
              <cite class="text-sm text-secondary-500 mt-2 block">- Ian Straayer, Manager of Quality Improvement</cite>
            </div>
          </div>
        </div>

        <!-- Case Study 3 -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden hover-lift animate-on-scroll">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="p-8 lg:p-12">
              <div class="inline-flex items-center px-3 py-1 bg-secondary-100 text-secondary-700 rounded-full text-sm font-semibold mb-4">
                Community Health Plan
              </div>
              <h3 class="text-3xl font-bold text-secondary-900 mb-4">
                Alameda Alliance for Health
              </h3>
              <p class="text-lg text-secondary-600 mb-6 leading-relaxed">
                Exceptional member engagement rates leading to improved quality of life and health outcomes across diverse populations.
              </p>
              
              <div class="grid grid-cols-2 gap-6 mb-6">
                <div>
                  <div class="text-3xl font-bold text-primary-600 mb-1">90%+</div>
                  <div class="text-sm text-secondary-600">Daily Engagement</div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-accent-600 mb-1">25%</div>
                  <div class="text-sm text-secondary-600">Quality Score Increase</div>
                </div>
              </div>
              
              <blockquote class="text-secondary-700 italic border-l-4 border-secondary-500 pl-4">
                "Seeing more than 90% of our members engage with this platform daily is a testament to the program's effectiveness. We've seen significant improvements in our members' health outcomes and quality of life."
              </blockquote>
              <cite class="text-sm text-secondary-500 mt-2 block">- Renee Kieffer, Nurse Practitioner</cite>
            </div>
            <div class="relative">
              <img src="https://images.pexels.com/photos/4386431/pexels-photo-4386431.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Diverse healthcare team" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator Section -->
  <section class="py-20 bg-gradient-to-br from-primary-600 to-primary-800 text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          Calculate Your ROI
        </h2>
        <p class="text-xl text-primary-100 mb-12 leading-relaxed">
          See the potential impact on your organization's health outcomes and cost savings
        </p>
        
        <div class="bg-white/10 backdrop-blur-lg rounded-3xl p-8 md:p-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
            <div class="text-center">
              <div class="text-4xl font-bold text-accent-300 mb-2">3:1</div>
              <div class="text-primary-100">Average ROI Ratio</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-bold text-accent-300 mb-2">6 months</div>
              <div class="text-primary-100">Time to ROI</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-bold text-accent-300 mb-2">$1,200</div>
              <div class="text-primary-100">Avg. Savings per Member</div>
            </div>
          </div>
          
          <p class="text-lg text-primary-100 mb-8">
            Our guaranteed ROI model means you only pay when you see results in care plan adherence.
          </p>
          
          <a href="/contact" class="inline-flex items-center bg-white text-primary-700 font-bold py-4 px-8 rounded-full hover:bg-primary-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
            <span>Get Your Custom ROI Analysis</span>
            <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Clinical Evidence -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-6">
          Clinical Evidence
        </h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          Our outcomes are backed by rigorous clinical research and peer-reviewed studies
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-primary-50 to-primary-100 rounded-3xl p-8 hover-lift animate-on-scroll">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-secondary-900 mb-4">Peer-Reviewed Research</h3>
          <p class="text-secondary-600 leading-relaxed">Published studies demonstrating the effectiveness of behavioral economics in healthcare engagement.</p>
        </div>
        
        <div class="bg-gradient-to-br from-accent-50 to-accent-100 rounded-3xl p-8 hover-lift animate-on-scroll" style="animation-delay: 0.1s;">
          <div class="w-16 h-16 bg-gradient-to-br from-accent-500 to-accent-600 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-secondary-900 mb-4">Real-World Evidence</h3>
          <p class="text-secondary-600 leading-relaxed">Comprehensive data analysis from over 30 million daily check-ins across diverse populations.</p>
        </div>
        
        <div class="bg-gradient-to-br from-secondary-50 to-secondary-100 rounded-3xl p-8 hover-lift animate-on-scroll" style="animation-delay: 0.2s;">
          <div class="w-16 h-16 bg-gradient-to-br from-secondary-500 to-secondary-600 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-secondary-900 mb-4">Behavioral Science</h3>
          <p class="text-secondary-600 leading-relaxed">Evidence-based behavioral interventions designed by leading experts in behavioral economics.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-accent-600 to-accent-800 text-white">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-3xl mx-auto animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          Ready to See These Results?
        </h2>
        <p class="text-xl text-accent-100 mb-8 leading-relaxed">
          Join leading healthcare organizations achieving measurable improvements in health outcomes and cost savings.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center bg-white text-accent-700 font-bold py-4 px-8 rounded-full hover:bg-accent-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
            <span>Schedule a Demo</span>
            <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a href="/solution" class="inline-flex items-center border-2 border-white text-white font-bold py-4 px-8 rounded-full hover:bg-white hover:text-accent-700 transition-all duration-300 group">
            <span>Learn About Our Platform</span>
            <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>