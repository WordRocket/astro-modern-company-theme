---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resources" description="Healthcare insights, research, and resources on behavioral economics and population health">
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-gradient-to-br from-secondary-50 via-white to-accent-50 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(0,0,0,0.15) 1px, transparent 0); background-size: 30px 30px;"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center animate-on-scroll">
        <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-secondary-100 to-accent-100 rounded-full text-sm font-semibold text-secondary-700 mb-6">
          <span class="w-2 h-2 bg-accent-500 rounded-full mr-2 animate-pulse"></span>
          Knowledge Hub
        </div>
        
        <h1 class="text-5xl md:text-6xl font-bold text-secondary-900 mb-6">
          Healthcare <span class="bg-gradient-to-r from-secondary-600 to-accent-500 bg-clip-text text-transparent">Resources</span>
        </h1>
        
        <p class="text-xl text-secondary-600 leading-relaxed max-w-3xl mx-auto">
          Explore insights, research, and best practices in behavioral economics, population health, and healthcare engagement.
        </p>
      </div>
    </div>
  </section>

  <!-- Resource Categories -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center group cursor-pointer animate-on-scroll" onclick="filterResources('whitepapers')">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-secondary-900 mb-2">Whitepapers</h3>
          <p class="text-secondary-600 text-sm">In-depth research and analysis</p>
        </div>
        
        <div class="text-center group cursor-pointer animate-on-scroll" style="animation-delay: 0.1s;" onclick="filterResources('case-studies')">
          <div class="w-20 h-20 bg-gradient-to-br from-accent-500 to-accent-600 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-secondary-900 mb-2">Case Studies</h3>
          <p class="text-secondary-600 text-sm">Real-world success stories</p>
        </div>
        
        <div class="text-center group cursor-pointer animate-on-scroll" style="animation-delay: 0.2s;" onclick="filterResources('webinars')">
          <div class="w-20 h-20 bg-gradient-to-br from-secondary-500 to-secondary-600 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-secondary-900 mb-2">Webinars</h3>
          <p class="text-secondary-600 text-sm">Expert insights and discussions</p>
        </div>
        
        <div class="text-center group cursor-pointer animate-on-scroll" style="animation-delay: 0.3s;" onclick="filterResources('guides')">
          <div class="w-20 h-20 bg-gradient-to-br from-primary-600 to-accent-500 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-secondary-900 mb-2">Guides</h3>
          <p class="text-secondary-600 text-sm">Implementation best practices</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Resources -->
  <section class="py-20 bg-gradient-to-br from-primary-50 to-accent-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-6">
          Featured Resources
        </h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          Our most popular and impactful resources for healthcare leaders
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Whitepaper 1 -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden hover-lift animate-on-scroll" data-category="whitepapers">
          <div class="relative h-48">
            <img src="https://images.pexels.com/photos/3184291/pexels-photo-3184291.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Healthcare data analysis" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="bg-primary-500 text-white px-3 py-1 rounded-full text-sm font-semibold">Whitepaper</span>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-secondary-900 mb-3">
              The Science of Behavioral Economics in Healthcare
            </h3>
            <p class="text-secondary-600 mb-4 leading-relaxed">
              Comprehensive analysis of how behavioral economics principles drive sustainable health behavior change.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-sm text-secondary-500">15 min read</span>
              <a href="#" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors duration-200">
                Download PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Case Study 1 -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden hover-lift animate-on-scroll" style="animation-delay: 0.1s;" data-category="case-studies">
          <div class="relative h-48">
            <img src="https://images.pexels.com/photos/4386467/pexels-photo-4386467.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Healthcare provider with patient" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="bg-accent-500 text-white px-3 py-1 rounded-full text-sm font-semibold">Case Study</span>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-secondary-900 mb-3">
              92% Medication Adherence: Desert Oasis Success Story
            </h3>
            <p class="text-secondary-600 mb-4 leading-relaxed">
              How a Medicare Advantage plan achieved exceptional results with hard-to-reach diabetic patients.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-sm text-secondary-500">8 min read</span>
              <a href="#" class="text-accent-600 font-semibold hover:text-accent-700 transition-colors duration-200">
                Read More
              </a>
            </div>
          </div>
        </div>

        <!-- Webinar 1 -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden hover-lift animate-on-scroll" style="animation-delay: 0.2s;" data-category="webinars">
          <div class="relative h-48">
            <img src="https://images.pexels.com/photos/3184360/pexels-photo-3184360.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Healthcare webinar" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="bg-secondary-500 text-white px-3 py-1 rounded-full text-sm font-semibold">Webinar</span>
            </div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="bg-white/90 backdrop-blur-sm text-secondary-600 p-4 rounded-full">
                <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-secondary-900 mb-3">
              Population Health Strategies for 2025
            </h3>
            <p class="text-secondary-600 mb-4 leading-relaxed">
              Expert panel discussion on emerging trends and best practices in population health management.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-sm text-secondary-500">45 min watch</span>
              <a href="#" class="text-secondary-600 font-semibold hover:text-secondary-700 transition-colors duration-200">
                Watch Now
              </a>
            </div>
          </div>
        </div>

        <!-- Guide 1 -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden hover-lift animate-on-scroll" style="animation-delay: 0.3s;" data-category="guides">
          <div class="relative h-48">
            <img src="https://images.pexels.com/photos/3184431/pexels-photo-3184431.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Healthcare implementation guide" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="bg-gradient-to-r from-primary-500 to-accent-500 text-white px-3 py-1 rounded-full text-sm font-semibold">Guide</span>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-secondary-900 mb-3">
              Implementation Guide: Getting Started
            </h3>
            <p class="text-secondary-600 mb-4 leading-relaxed">
              Step-by-step guide to implementing behavioral health programs in your organization.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-sm text-secondary-500">12 min read</span>
              <a href="#" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors duration-200">
                Download
              </a>
            </div>
          </div>
        </div>

        <!-- Whitepaper 2 -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden hover-lift animate-on-scroll" style="animation-delay: 0.4s;" data-category="whitepapers">
          <div class="relative h-48">
            <img src="https://images.pexels.com/photos/3184465/pexels-photo-3184465.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Healthcare research" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="bg-primary-500 text-white px-3 py-1 rounded-full text-sm font-semibold">Whitepaper</span>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-secondary-900 mb-3">
              ROI Analysis: Behavioral Health Programs
            </h3>
            <p class="text-secondary-600 mb-4 leading-relaxed">
              Detailed financial analysis of behavioral health program investments and returns.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-sm text-secondary-500">20 min read</span>
              <a href="#" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors duration-200">
                Download PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Case Study 2 -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden hover-lift animate-on-scroll" style="animation-delay: 0.5s;" data-category="case-studies">
          <div class="relative h-48">
            <img src="https://images.pexels.com/photos/4386431/pexels-photo-4386431.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Diverse healthcare team" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="bg-accent-500 text-white px-3 py-1 rounded-full text-sm font-semibold">Case Study</span>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-secondary-900 mb-3">
              $2.3M Cost Savings: Priority Health Results
            </h3>
            <p class="text-secondary-600 mb-4 leading-relaxed">
              How Priority Health achieved significant cost reductions through improved member engagement.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-sm text-secondary-500">10 min read</span>
              <a href="#" class="text-accent-600 font-semibold hover:text-accent-700 transition-colors duration-200">
                Read More
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="py-20 bg-gradient-to-br from-primary-600 to-primary-800 text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          Stay Informed
        </h2>
        <p class="text-xl text-primary-100 mb-8 leading-relaxed">
          Get the latest insights, research, and best practices delivered to your inbox monthly.
        </p>
        
        <div class="bg-white/10 backdrop-blur-lg rounded-3xl p-8">
          <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
            <input 
              type="email" 
              placeholder="Enter your email" 
              class="flex-1 px-4 py-3 rounded-full text-secondary-900 focus:outline-none focus:ring-2 focus:ring-accent-400"
              required
            >
            <button 
              type="submit" 
              class="bg-accent-500 text-white px-6 py-3 rounded-full font-semibold hover:bg-accent-600 transition-colors duration-200 whitespace-nowrap"
            >
              Subscribe
            </button>
          </form>
          <p class="text-sm text-primary-200 mt-4">
            No spam. Unsubscribe anytime. Privacy policy applies.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Resource Library -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-6">
          Complete Resource Library
        </h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          Browse our comprehensive collection of healthcare resources
        </p>
      </div>
      
      <!-- Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <button class="filter-btn active px-6 py-3 rounded-full font-semibold transition-all duration-200" data-filter="all">
          All Resources
        </button>
        <button class="filter-btn px-6 py-3 rounded-full font-semibold transition-all duration-200" data-filter="whitepapers">
          Whitepapers
        </button>
        <button class="filter-btn px-6 py-3 rounded-full font-semibold transition-all duration-200" data-filter="case-studies">
          Case Studies
        </button>
        <button class="filter-btn px-6 py-3 rounded-full font-semibold transition-all duration-200" data-filter="webinars">
          Webinars
        </button>
        <button class="filter-btn px-6 py-3 rounded-full font-semibold transition-all duration-200" data-filter="guides">
          Guides
        </button>
      </div>
      
      <!-- Resource Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="resource-grid">
        <!-- Resources will be filtered here -->
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-accent-600 to-accent-800 text-white">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-3xl mx-auto animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          Need Custom Research?
        </h2>
        <p class="text-xl text-accent-100 mb-8 leading-relaxed">
          Our team can provide custom research and analysis tailored to your organization's specific needs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center bg-white text-accent-700 font-bold py-4 px-8 rounded-full hover:bg-accent-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
            <span>Request Custom Research</span>
            <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a href="/solution" class="inline-flex items-center border-2 border-white text-white font-bold py-4 px-8 rounded-full hover:bg-white hover:text-accent-700 transition-all duration-300 group">
            <span>Explore Our Platform</span>
            <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Resource filtering functionality
  const filterButtons = document.querySelectorAll('.filter-btn');
  const resourceCards = document.querySelectorAll('[data-category]');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');
      
      // Update active button
      filterButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');
      
      // Filter resources
      resourceCards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.style.display = 'block';
          card.classList.add('animate-on-scroll');
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Filter function for category clicks
  function filterResources(category) {
    const button = document.querySelector(`[data-filter="${category}"]`);
    if (button) {
      button.click();
      // Scroll to resource grid
      document.getElementById('resource-grid').scrollIntoView({ 
        behavior: 'smooth',
        block: 'start'
      });
    }
  }
</script>

<style>
  .filter-btn {
    @apply bg-secondary-100 text-secondary-700 hover:bg-primary-100 hover:text-primary-700;
  }
  
  .filter-btn.active {
    @apply bg-primary-600 text-white;
  }
</style>