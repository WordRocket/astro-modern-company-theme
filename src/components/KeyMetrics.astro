---
const metrics = [
  { 
    value: '91', 
    label: 'Daily Care Plan Engagement', 
    symbol: '%',
    description: 'Members actively engage with their care plans every day',
    color: 'from-primary-500 to-primary-600'
  },
  { 
    value: '16', 
    label: 'Increased PDC Medication Adherence', 
    symbol: '%',
    description: 'Improvement in medication adherence rates',
    color: 'from-accent-500 to-accent-600'
  },
  { 
    value: '51', 
    label: 'Lower Inpatient Admission', 
    symbol: '%',
    description: 'Reduction in hospital admissions',
    color: 'from-primary-600 to-accent-500'
  },
];
---

<section class="py-20 bg-gradient-to-br from-secondary-50 to-primary-50 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(0,0,0,0.15) 1px, transparent 0); background-size: 20px 20px;"></div>
  </div>
  
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-4">
        Proven Results That Matter
      </h2>
      <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
        Our platform delivers measurable outcomes that transform healthcare engagement and reduce costs
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      {metrics.map((metric, index) => (
        <div class="group animate-on-scroll hover-lift" style={`animation-delay: ${index * 0.1}s`}>
          <div class="bg-white rounded-3xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-secondary-100 relative overflow-hidden">
            <!-- Background gradient -->
            <div class={`absolute inset-0 bg-gradient-to-br ${metric.color} opacity-0 group-hover:opacity-5 transition-opacity duration-500`}></div>
            
            <div class="relative z-10">
              <div class="flex items-baseline justify-center mb-4">
                <span class={`text-6xl md:text-7xl font-bold bg-gradient-to-r ${metric.color} bg-clip-text text-transparent`}>
                  {metric.value}
                </span>
                <span class={`text-4xl md:text-5xl font-bold bg-gradient-to-r ${metric.color} bg-clip-text text-transparent ml-1`}>
                  {metric.symbol}
                </span>
              </div>
              
              <h3 class="text-lg font-bold text-secondary-900 mb-3 text-center leading-tight">
                {metric.label}
              </h3>
              
              <p class="text-secondary-600 text-center text-sm leading-relaxed">
                {metric.description}
              </p>
              
              <!-- Decorative element -->
              <div class={`w-16 h-1 bg-gradient-to-r ${metric.color} mx-auto mt-4 rounded-full transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500`}></div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Call to action -->
    <div class="text-center mt-16 animate-on-scroll">
      <p class="text-lg text-secondary-600 mb-6">
        Ready to see these results for your organization?
      </p>
      <a href="/outcomes" class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-primary-600 to-primary-700 text-white rounded-full font-semibold transition-all duration-300 hover:shadow-xl hover:shadow-primary-500/25 hover:-translate-y-1 group">
        View Detailed Outcomes
        <svg class="w-5 h-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>