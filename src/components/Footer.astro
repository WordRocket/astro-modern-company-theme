---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';

const footerLinks = [
  { label: 'Home', href: '#' },
  { label: 'Solution', href: '#' },
  { label: 'Outcomes', href: '#' },
  { label: 'Company', href: '#' },
  { label: 'Resources', href: '#' },
  { label: 'Careers', href: '#' },
  { label: 'Contact Us', href: '#' },
  { label: 'Member Support', href: '#' },
];
---

<footer class="bg-gray-900 text-white py-12">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <div>
        <Image 
          src={logoImg} 
          alt="Company Logo Image" 
          class="rounded-lg"
          width={48}
          height={48}
        />
        <p class="font-serif font-bold pt-2 text-xl">The Minor Surgery Center</p>
        <p class="text-sm pt-2">Expert surgical care across the GTA.</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          {[
            { label: 'Our Clinics', href: '/clinics' },
            { label: 'Conditions', href: '/conditions' },
            { label: 'Our Team', href: '/team' },
            { label: 'FAQs', href: '/faqs' },
            { label: 'Pricing', href: '/pricing' },
            { label: 'Blog', href: '/blog' },
            { label: 'Contact Us', href: '/contact' },
            { label: 'Book Consultation', href: '/contact' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-primary-300">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4">Contact Info</h3>
        <div class="space-y-3">
          <div>
            <p class="text-sm font-semibold">Phone</p>
            <a href="tel:647-614-1611" class="text-sm text-primary-300 hover:text-white">(647) 614-1611</a>
          </div>
          <div>
            <p class="text-sm font-semibold">Email</p>
            <a href="mailto:info@minorsurgerycenter.com" class="text-sm text-primary-300 hover:text-white">info@minorsurgerycenter.com</a>
          </div>
          <div>
            <p class="text-sm font-semibold">Locations</p>
            <p class="text-sm">Toronto • Oakville • Vaughan • Mississauga</p>
          </div>
        </div>
      </div>
    </div>
    <div class="border-t border-gray-700 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-sm mb-4 md:mb-0">&copy; 2025 The Minor Surgery Center. All rights reserved.</p>
      <div class="flex space-x-4">
        <a href="#" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white">
          <span class="sr-only">LinkedIn</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="#" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white">
          <span class="sr-only">Facebook</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
