---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-image.png';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-primary-50 via-white to-accent-50">
  <!-- Background Elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-gradient-to-br from-primary-200 to-accent-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-float"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-gradient-to-br from-accent-200 to-primary-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-float" style="animation-delay: -2s;"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gradient-to-br from-primary-100 to-accent-100 rounded-full mix-blend-multiply filter blur-2xl opacity-50 animate-float" style="animation-delay: -4s;"></div>
  </div>
  
  <div class="container mx-auto px-4 py-20 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
      <div class="lg:w-1/2 text-center lg:text-left animate-on-scroll">
        <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-primary-100 to-accent-100 rounded-full text-sm font-semibold text-primary-700 mb-6 animate-bounce-gentle">
          <span class="w-2 h-2 bg-accent-500 rounded-full mr-2 animate-pulse"></span>
          Board Certified Plastic Surgeons
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-secondary-900 mb-6 leading-tight">
          Experience Expedited Care with Our
          <span class="bg-gradient-to-r from-primary-600 via-primary-500 to-accent-500 bg-clip-text text-transparent animate-gradient">
            Specialist Surgeons
          </span>
        </h1>
        
        <p class="text-lg sm:text-xl text-secondary-600 mb-8 max-w-2xl leading-relaxed">
          The Minor Surgery Center is a group of state-of-the-art facilities located in Toronto, Oakville, Vaughan and Mississauga. We offer no referral, rapid access for surgeries of the skin and hand, treating over 10,000 patients a year.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="/contact" class="group relative overflow-hidden bg-gradient-to-r from-primary-600 to-primary-700 text-white px-8 py-4 rounded-full font-semibold text-lg transition-all duration-300 hover:shadow-xl hover:shadow-primary-500/25 hover:-translate-y-1">
            <span class="relative z-10 flex items-center">
              Book a Free Consultation
              <svg class="w-5 h-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </span>
            <div class="absolute inset-0 bg-gradient-to-r from-primary-700 to-primary-800 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
          </a>
          
          <a href="tel:647-614-1611" class="group flex items-center justify-center px-8 py-4 border-2 border-secondary-300 text-secondary-700 rounded-full font-semibold text-lg transition-all duration-300 hover:border-primary-500 hover:text-primary-600 hover:bg-primary-50">
            <svg class="w-6 h-6 mr-3 transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            (647) 614-1611
          </a>
        </div>
        
        <!-- Stats -->
        <div class="grid grid-cols-3 gap-8 mt-12 pt-8 border-t border-secondary-200">
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold text-primary-600 mb-1">10,000+</div>
            <div class="text-sm text-secondary-600">Patients Treated</div>
          </div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold text-accent-600 mb-1">4.8★</div>
            <div class="text-sm text-secondary-600">Google Rating</div>
          </div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold text-primary-600 mb-1">No</div>
            <div class="text-sm text-secondary-600">Referral Needed</div>
          </div>
        </div>
      </div>
      
      <div class="lg:w-1/2 relative animate-on-scroll" style="animation-delay: 0.2s;">
        <div class="relative">
          <!-- Floating elements -->
          <div class="absolute -top-6 -left-6 w-24 h-24 bg-gradient-to-br from-primary-400 to-accent-400 rounded-2xl opacity-20 animate-float"></div>
          <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-gradient-to-br from-accent-400 to-primary-400 rounded-2xl opacity-20 animate-float" style="animation-delay: -1s;"></div>
          
          <div class="relative overflow-hidden rounded-3xl shadow-2xl hover-lift">
            <Image 
              src={heroImg} 
              alt="Professional medical facility and surgical team" 
              class="w-full h-auto"
              width={600}
              height={400}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
            
            <!-- Play button overlay -->
            <button
              id="playButtonOverlay"
              class="absolute inset-0 flex items-center justify-center group"
            >
              <div class="bg-white/90 backdrop-blur-sm text-primary-600 p-6 rounded-full shadow-xl transition-all duration-300 group-hover:bg-white group-hover:scale-110">
                <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </button>
          </div>
          
          <!-- Floating cards -->
          <div class="absolute -right-4 top-1/4 bg-white rounded-2xl shadow-xl p-4 animate-float" style="animation-delay: -0.5s;">
            <div class="flex items-center space-x-3">
              <div class="w-3 h-3 bg-accent-500 rounded-full animate-pulse"></div>
              <span class="text-sm font-semibold text-secondary-700">Same Day Surgery</span>
            </div>
          </div>
          
          <div class="absolute -left-4 bottom-1/4 bg-white rounded-2xl shadow-xl p-4 animate-float" style="animation-delay: -1.5s;">
            <div class="flex items-center space-x-3">
              <div class="w-3 h-3 bg-primary-500 rounded-full animate-pulse"></div>
              <span class="text-sm font-semibold text-secondary-700">Board Certified</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Video Modal -->
<div id="videoModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 opacity-0 invisible transition-all duration-300">
  <div class="bg-white rounded-2xl p-6 max-w-4xl w-full transform scale-95 transition-all duration-300" id="modalContent">
    <div class="flex justify-between items-center mb-6">
      <h3 class="text-2xl font-bold text-secondary-900">How Your Company Works</h3>
      <button id="closeModal" class="p-2 rounded-full hover:bg-secondary-100 transition-colors duration-200">
        <svg class="w-6 h-6 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="aspect-video rounded-xl overflow-hidden">
      <iframe 
        id="youtubeVideo"
        class="w-full h-full"
        src="https://www.youtube.com/embed/f4D55v97wLM"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</div>

<script>
  const playButton = document.getElementById('playButton');
  const playButtonOverlay = document.getElementById('playButtonOverlay');
  const videoModal = document.getElementById('videoModal');
  const modalContent = document.getElementById('modalContent');
  const closeModal = document.getElementById('closeModal');
  const youtubeVideo = document.getElementById('youtubeVideo') as HTMLIFrameElement;

  const openModal = () => {
    videoModal?.classList.remove('opacity-0', 'invisible');
    modalContent?.classList.remove('scale-95');
    modalContent?.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  };

  const closeModalFunc = () => {
    videoModal?.classList.add('opacity-0', 'invisible');
    modalContent?.classList.remove('scale-100');
    modalContent?.classList.add('scale-95');
    document.body.style.overflow = '';
    youtubeVideo?.contentWindow?.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
  };

  playButton?.addEventListener('click', openModal);
  playButtonOverlay?.addEventListener('click', openModal);
  closeModal?.addEventListener('click', closeModalFunc);

  videoModal?.addEventListener('click', (e) => {
    if (e.target === videoModal) {
      closeModalFunc();
    }
  });
</script>