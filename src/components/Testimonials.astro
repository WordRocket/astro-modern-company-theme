---
import { Image } from 'astro:assets';
import brianHodgkinsImg from "../assets/brian-hodgkins.png"
import jillFeldmanImg from "../assets/jill-feldman.png"
import ianStraayerImg from "../assets/ian-straayer.png"
import reneeKiefferImg from "../assets/renee-kieffer.png"
const testimonials = [
  {
    quote: "Dr. Dibildox is without a doubt the most professional, skilled surgeon I have ever met. The entire team in Oakville are very caring and professional. This has been a very positive experience. I would not hesitate to refer them to anyone in need.",
    author: "Chuck Resnick",
    title: "Patient",
    company: "Oakville Clinic",
    image: brianHodgkinsImg
  },
  {
    quote: "Great experience! In and out so quickly and painlessly. Staff was very professional and friendly. Would highly recommend!",
    author: "Kristin Maydell",
    title: "Patient",
    company: "Toronto Clinic",
    image: jillFeldmanImg
  },
  {
    quote: "I was so grateful for the flexibility at the clinic today. The desk staff were able to accommodate me and I was able to get my procedure with no waiting. I was extremely grateful.",
    author: "Kelli Taber",
    title: "Patient",
    company: "Vaughan Clinic",
    image: ianStraayerImg
  },
  {
    quote: "The procedure was quick and professional. The surgeon explained everything clearly and the results exceeded my expectations. Minimal scarring and excellent care throughout.",
    author: "Sarah Johnson",
    title: "Patient",
    company: "Mississauga Clinic",
    image: reneeKiefferImg
  },
];
---

<section class="bg-gray-100 py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-serif font-bold text-center mb-12">What Our Patients Say</h2>
    <div class="text-center mb-8">
      <div class="inline-flex items-center space-x-2">
        <span class="text-2xl font-bold text-primary-600">4.8</span>
        <div class="flex space-x-1">
          {[1,2,3,4,5].map(() => (
            <svg class="w-6 h-6 text-yellow-400 fill-current" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          ))}
        </div>
        <span class="text-gray-600">based on 500+ reviews</span>
      </div>
    </div>
    <div class="flex overflow-x-auto snap-x snap-mandatory">
      {testimonials.map((testimonial) => (
        <div class="flex-shrink-0 w-full sm:w-1/2 md:w-1/3 snap-start">
          <div class="bg-white rounded-lg shadow-lg p-8 mx-4">
            <p class="text-gray-600 italic mb-4">{testimonial.quote}</p>
            <div class="flex items-center">
              <Image 
                src={testimonial.image} 
                alt={testimonial.author} 
                class="w-12 h-12 rounded-full mr-4"
                // width={600}
                // height={400}
              />
              <div>
                <p class="font-semibold">{testimonial.author}</p>
                <p class="text-sm text-gray-500">{testimonial.title}</p>
                <p class="text-sm text-gray-500">{testimonial.company}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
