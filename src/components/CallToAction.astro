---
---

<section class="py-20 bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 text-white relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0">
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-primary-600/50 to-transparent"></div>
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-white/10 rounded-full blur-3xl animate-float"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-accent-400/20 rounded-full blur-3xl animate-float" style="animation-delay: -2s;"></div>
  </div>
  
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl mx-auto text-center animate-on-scroll">
      <div class="bg-white/10 backdrop-blur-lg rounded-3xl p-8 md:p-12 shadow-2xl border border-white/20">
        <div class="inline-flex items-center px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full text-sm font-semibold text-white mb-8">
          <span class="w-2 h-2 bg-accent-300 rounded-full mr-2 animate-pulse"></span>
          Expert Surgical Care
        </div>
        
        <h2 class="text-4xl md:text-6xl font-bold mb-8 leading-tight">
          Quick, Effective & <span class="bg-gradient-to-r from-accent-300 to-white bg-clip-text text-transparent">Painless</span>
        </h2>
        
        <div class="space-y-6 mb-12">
          <p class="text-2xl font-medium text-primary-100">
            Each case is tended to with great care, and scarring is always minimal.
          </p>
          
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
            <p class="text-xl text-primary-100 leading-relaxed">
              Our procedures are performed by <span class="font-bold text-accent-300">board certified plastic surgeons</span> in state-of-the-art facilities across the GTA.
            </p>
          </div>
        </div>
        
        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          <div class="text-center">
            <div class="text-4xl font-bold text-accent-300 mb-2">10,000+</div>
            <div class="text-primary-200">Procedures Completed</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold text-accent-300 mb-2">Same Day</div>
            <div class="text-primary-200">Surgery Available</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold text-accent-300 mb-2">4.8★</div>
            <div class="text-primary-200">Google Rating</div>
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center bg-white text-primary-700 font-bold py-4 px-8 rounded-full hover:bg-primary-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
            <span>Book Free Consultation</span>
            <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          
          <a href="tel:647-614-1611" class="inline-flex items-center border-2 border-white text-white font-bold py-4 px-8 rounded-full hover:bg-white hover:text-primary-700 transition-all duration-300 group">
            <span>Call (647) 614-1611</span>
            <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>