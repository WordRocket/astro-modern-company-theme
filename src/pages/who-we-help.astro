---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Who We Help" description="Discover how we serve health plans, providers, and members across diverse populations">
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-gradient-to-br from-accent-50 via-white to-primary-50 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(0,0,0,0.15) 1px, transparent 0); background-size: 30px 30px;"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center animate-on-scroll">
        <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-accent-100 to-primary-100 rounded-full text-sm font-semibold text-accent-700 mb-6">
          <span class="w-2 h-2 bg-primary-500 rounded-full mr-2 animate-pulse"></span>
          Serving Diverse Healthcare Stakeholders
        </div>
        
        <h1 class="text-5xl md:text-6xl font-bold text-secondary-900 mb-6">
          Who We <span class="bg-gradient-to-r from-accent-600 to-primary-500 bg-clip-text text-transparent">Help</span>
        </h1>
        
        <p class="text-xl text-secondary-600 leading-relaxed max-w-3xl mx-auto">
          We partner with health plans, healthcare providers, and serve members across diverse populations to improve health outcomes and reduce costs.
        </p>
      </div>
    </div>
  </section>

  <!-- Health Plans Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="animate-on-scroll">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <h2 class="text-4xl font-bold text-secondary-900 mb-6">
            Health Plans & Payers
          </h2>
          <p class="text-lg text-secondary-600 mb-8 leading-relaxed">
            We help health plans achieve better Star Ratings, reduce medical costs, and improve member satisfaction through evidence-based behavioral interventions.
          </p>
          
          <div class="space-y-4">
            <div class="flex items-center space-x-3">
              <div class="w-2 h-2 bg-primary-500 rounded-full"></div>
              <span class="text-secondary-700">Medicare Advantage Plans</span>
            </div>
            <div class="flex items-center space-x-3">
              <div class="w-2 h-2 bg-primary-500 rounded-full"></div>
              <span class="text-secondary-700">Medicaid Managed Care Organizations</span>
            </div>
            <div class="flex items-center space-x-3">
              <div class="w-2 h-2 bg-primary-500 rounded-full"></div>
              <span class="text-secondary-700">Commercial Health Plans</span>
            </div>
            <div class="flex items-center space-x-3">
              <div class="w-2 h-2 bg-primary-500 rounded-full"></div>
              <span class="text-secondary-700">Accountable Care Organizations</span>
            </div>
          </div>
        </div>
        
        <div class="animate-on-scroll" style="animation-delay: 0.2s;">
          <div class="relative">
            <img src="https://images.pexels.com/photos/3184360/pexels-photo-3184360.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Healthcare executives in meeting" class="rounded-3xl shadow-2xl w-full hover-lift">
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent rounded-3xl"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Healthcare Providers Section -->
  <section class="py-20 bg-gradient-to-br from-secondary-50 to-accent-50">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="animate-on-scroll lg:order-2">
          <div class="w-16 h-16 bg-gradient-to-br from-accent-500 to-accent-600 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h2 class="text-4xl font-bold text-secondary-900 mb-6">
            Healthcare Providers
          </h2>
          <p class="text-lg text-secondary-600 mb-8 leading-relaxed">
            We support healthcare providers in improving patient outcomes, reducing readmissions, and enhancing care quality through sustained patient engagement.
          </p>
          
          <div class="space-y-4">
            <div class="flex items-center space-x-3">
              <div class="w-2 h-2 bg-accent-500 rounded-full"></div>
              <span class="text-secondary-700">Primary Care Practices</span>
            </div>
            <div class="flex items-center space-x-3">
              <div class="w-2 h-2 bg-accent-500 rounded-full"></div>
              <span class="text-secondary-700">Specialty Care Centers</span>
            </div>
            <div class="flex items-center space-x-3">
              <div class="w-2 h-2 bg-accent-500 rounded-full"></div>
              <span class="text-secondary-700">Health Systems</span>
            </div>
            <div class="flex items-center space-x-3">
              <div class="w-2 h-2 bg-accent-500 rounded-full"></div>
              <span class="text-secondary-700">Community Health Centers</span>
            </div>
          </div>
        </div>
        
        <div class="animate-on-scroll lg:order-1" style="animation-delay: 0.2s;">
          <div class="relative">
            <img src="https://images.pexels.com/photos/4386467/pexels-photo-4386467.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Healthcare provider with patient" class="rounded-3xl shadow-2xl w-full hover-lift">
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent rounded-3xl"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Member Populations Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-6">
          Member Populations We Serve
        </h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          Our platform is designed to engage diverse populations, especially those who are hardest to reach through traditional healthcare approaches.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-primary-50 to-primary-100 rounded-3xl p-8 hover-lift animate-on-scroll">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-secondary-900 mb-4">Chronic Conditions</h3>
          <p class="text-secondary-600 leading-relaxed mb-4">Supporting individuals with diabetes, hypertension, heart disease, and other chronic conditions.</p>
          <ul class="text-sm text-secondary-600 space-y-2">
            <li>• Type 2 Diabetes Management</li>
            <li>• Cardiovascular Disease</li>
            <li>• Chronic Kidney Disease</li>
            <li>• COPD & Asthma</li>
          </ul>
        </div>
        
        <div class="bg-gradient-to-br from-accent-50 to-accent-100 rounded-3xl p-8 hover-lift animate-on-scroll" style="animation-delay: 0.1s;">
          <div class="w-16 h-16 bg-gradient-to-br from-accent-500 to-accent-600 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-secondary-900 mb-4">Diverse Communities</h3>
          <p class="text-secondary-600 leading-relaxed mb-4">Culturally sensitive programs for underserved and diverse populations.</p>
          <ul class="text-sm text-secondary-600 space-y-2">
            <li>• Multi-language Support</li>
            <li>• Cultural Competency</li>
            <li>• Rural Communities</li>
            <li>• Urban Underserved</li>
          </ul>
        </div>
        
        <div class="bg-gradient-to-br from-secondary-50 to-secondary-100 rounded-3xl p-8 hover-lift animate-on-scroll" style="animation-delay: 0.2s;">
          <div class="w-16 h-16 bg-gradient-to-br from-secondary-500 to-secondary-600 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-secondary-900 mb-4">High-Risk Members</h3>
          <p class="text-secondary-600 leading-relaxed mb-4">Specialized support for members with complex health needs and barriers to care.</p>
          <ul class="text-sm text-secondary-600 space-y-2">
            <li>• Multiple Comorbidities</li>
            <li>• Frequent Hospitalizations</li>
            <li>• Medication Non-adherence</li>
            <li>• Social Determinants</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Success Stories Section -->
  <section class="py-20 bg-gradient-to-br from-primary-600 to-primary-800 text-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          Real Impact Stories
        </h2>
        <p class="text-xl text-primary-100 max-w-3xl mx-auto">
          See how we're transforming lives across different healthcare organizations
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white/10 backdrop-blur-lg rounded-3xl p-8 hover-lift animate-on-scroll">
          <div class="text-4xl font-bold text-accent-300 mb-4">92%</div>
          <h3 class="text-xl font-bold mb-4">Medicare Advantage Plan</h3>
          <p class="text-primary-100 leading-relaxed">Achieved 92% medication adherence rate among diabetic members, resulting in 4.5 star rating improvement.</p>
        </div>
        
        <div class="bg-white/10 backdrop-blur-lg rounded-3xl p-8 hover-lift animate-on-scroll" style="animation-delay: 0.1s;">
          <div class="text-4xl font-bold text-accent-300 mb-4">45%</div>
          <h3 class="text-xl font-bold mb-4">Community Health Center</h3>
          <p class="text-primary-100 leading-relaxed">Reduced emergency department visits by 45% among high-risk patients with chronic conditions.</p>
        </div>
        
        <div class="bg-white/10 backdrop-blur-lg rounded-3xl p-8 hover-lift animate-on-scroll" style="animation-delay: 0.2s;">
          <div class="text-4xl font-bold text-accent-300 mb-4">$2.3M</div>
          <h3 class="text-xl font-bold mb-4">Regional Health System</h3>
          <p class="text-primary-100 leading-relaxed">Saved $2.3M in medical costs through improved care plan adherence and preventive care engagement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-3xl mx-auto animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-6">
          Ready to Transform Your Population Health?
        </h2>
        <p class="text-xl text-secondary-600 mb-8 leading-relaxed">
          Join leading healthcare organizations using our platform to improve outcomes and reduce costs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center bg-gradient-to-r from-primary-600 to-primary-700 text-white font-bold py-4 px-8 rounded-full hover:shadow-xl hover:shadow-primary-500/25 hover:-translate-y-1 transition-all duration-300 group">
            <span>Schedule a Demo</span>
            <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a href="/outcomes" class="inline-flex items-center border-2 border-primary-600 text-primary-600 font-bold py-4 px-8 rounded-full hover:bg-primary-600 hover:text-white transition-all duration-300 group">
            <span>View Case Studies</span>
            <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>