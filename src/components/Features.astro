---
import { FaScalpel, FaHandPaper, FaBandAid, FaUserMd, FaClock } from 'react-icons/fa';

const features = [
  { 
    icon: FaBandAid, 
    title: 'Skin Lesion Removal',
    description: 'Expert removal of moles, cysts, lipomas, and skin tags'
  },
  { 
    icon: FaHandPaper, 
    title: 'Hand Surgery',
    description: 'Carpal tunnel surgery and trigger finger treatment'
  },
  { 
    icon: FaScalpel, 
    title: 'Skin Cancer Treatment',
    description: 'Specialized treatment for basal and squamous cell carcinoma'
  },
  { 
    icon: FaClock, 
    title: 'Same Day Surgery',
    description: 'Often schedule your surgery the same day as consultation'
  },
  { 
    icon: FaUserMd, 
    title: 'No Referral Needed',
    description: 'Book directly with our board certified surgeons'
  },
];
---

<section class="py-20 bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 text-white relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0">
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-primary-600/50 to-transparent"></div>
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-accent-400/20 rounded-full blur-3xl"></div>
  </div>
  
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        We Treat Many Conditions
      </h2>
      <p class="text-xl text-primary-100 max-w-3xl mx-auto leading-relaxed">
        At TMSC, we specialize in surgical treatment of both benign and malignant skin lesions, as well as minor hand conditions. We offer significantly reduced wait times.
      </p>
    </div>

    <div class="bg-white/10 backdrop-blur-lg rounded-3xl p-8 md:p-12 shadow-2xl border border-white/20 mb-16 animate-on-scroll">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
        {features.map((feature, index) => (
          <div class="group text-center animate-on-scroll hover-lift" style={`animation-delay: ${index * 0.1}s`}>
            <div class="relative mb-6">
              <div class="w-20 h-20 mx-auto bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center group-hover:bg-white/30 transition-all duration-300 group-hover:scale-110">
                <feature.icon className="w-10 h-10 text-white" />
              </div>
              <div class="absolute inset-0 bg-gradient-to-br from-accent-400/20 to-primary-400/20 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur-xl"></div>
            </div>
            <h3 class="text-lg font-bold mb-3 text-white group-hover:text-accent-200 transition-colors duration-300">
              {feature.title}
            </h3>
            <p class="text-sm text-primary-200 leading-relaxed opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <div class="text-center animate-on-scroll">
      <p class="text-xl text-primary-100 mb-8 max-w-3xl mx-auto leading-relaxed">
        Our board certified surgeons have been trained at top institutions including McGill, McMaster, University of Toronto, Mayo Clinic, and Yale University.
      </p>

      <a href="/conditions" class="inline-flex items-center bg-white text-primary-700 font-bold py-4 px-8 rounded-full hover:bg-primary-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
        <span>View All Conditions We Treat</span>
        <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>